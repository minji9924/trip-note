{
  "name": "trip-note-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "vite --host --mode api",
    "build": "tsc && vite build",
    "build:api": "tsc && vite build --mode api",
    "preview": "vite preview --host",
